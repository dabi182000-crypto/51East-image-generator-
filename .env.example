# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# Your OpenAI API key. Server-side only — never exposed to the browser.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# MODEL CONFIGURATION (all optional — sensible defaults shown)
# ---------------------------------------------------------------------------
# Image generation / editing model. Change here to move to a newer model
# without touching any application code.
OPENAI_IMAGE_MODEL=gpt-image-2

# Vision model used by the optional "Product Accuracy Check" QC pass and by
# automatic product-category detection.
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional: custom API base URL (Azure / proxy / gateway).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: OpenAI organization / project scoping.
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# ---------------------------------------------------------------------------
# GENERATION DEFAULTS
# ---------------------------------------------------------------------------
# Native resolution requested from the API before post-processing.
# Must be a square value supported by the configured model.
OPENAI_IMAGE_SIZE=1024x1024

# low | medium | high | auto
OPENAI_IMAGE_QUALITY=high

# Milliseconds before a single image request is aborted.
OPENAI_TIMEOUT_MS=180000

# How many image requests may run at once (per server process).
GENERATION_CONCURRENCY=3

# ---------------------------------------------------------------------------
# OUTPUT PIPELINE
# ---------------------------------------------------------------------------
# Final delivered canvas. Mandatory square output.
OUTPUT_SIZE=1500

# Any pixel brighter than this on every channel AND connected to the image
# border is snapped to pure #FFFFFF. Raise it to be more conservative.
WHITE_CLEANUP_THRESHOLD=247

# Set to "false" to disable background whitening entirely.
WHITE_CLEANUP_ENABLED=true

# ---------------------------------------------------------------------------
# LIMITS
# ---------------------------------------------------------------------------
MAX_REFERENCE_IMAGES=12
MAX_REFERENCE_BYTES=20000000

# How long (ms) an in-memory session of references/results is retained.
SESSION_TTL_MS=10800000
